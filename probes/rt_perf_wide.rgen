#version 460
#extension GL_EXT_ray_tracing : require
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(set=0,binding=1,std430) buffer Output { uint values[]; } result;
layout(push_constant) uniform Params { uint rayCount; } params;
struct Payload { uvec4 data[16]; };
layout(location=0) rayPayloadEXT Payload payload;
void main() {
    uint sum = 0;
    for (uint ray = 0; ray < params.rayCount; ++ray) {
        for (uint i = 0; i < 16; ++i) payload.data[i] = uvec4(999u + i);
        traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 255, 0, 0, 0,
            vec3(float(gl_LaunchIDEXT.x & 1u) * 10.0, 0, -1), 0.001, vec3(0,0,1), 100.0, 0);
        for (uint i = 0; i < 16; ++i) {
            uvec4 v = payload.data[i];
            sum += v.x + v.y + v.z + v.w;
        }
    }
    result.values[gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x] = sum;
}
