# Local tools, downloaded dependencies and generated packages
/.local/
/.cache/
/.tools/
/build/
/build-*/
/deps-cache/
/gradle-cache/
/vulkan-sdk/
/downloads/*
!/downloads/README.md
/dist/
/logs/
# Experiment recipes and sources are public; all other experiment data stays local.
/experiments/*
!/experiments/README.md
!/experiments/E16-transparencia-nrd/
/experiments/E16-transparencia-nrd/*
!/experiments/E16-transparencia-nrd/README.md
!/experiments/E17-vida-recursos-metal/
/experiments/E17-vida-recursos-metal/*
!/experiments/E17-vida-recursos-metal/README.md
!/experiments/E18-ray-tracing/
/experiments/E18-ray-tracing/*
!/experiments/E18-ray-tracing/README.md
!/experiments/E19-lowcost/
/experiments/E19-lowcost/*
!/experiments/E19-lowcost/README.md
!/experiments/E20-presentacion-metal/
/experiments/E20-presentacion-metal/*
!/experiments/E20-presentacion-metal/README.md
!/experiments/E21-presets-nativos/
/experiments/E21-presets-nativos/*
!/experiments/E21-presets-nativos/README.md
!/experiments/E19-lowcost/preset.json
!/experiments/E20-presentacion-metal/present_stress.mm
/vk-config/
/magevk-compatible/
/magevk_radiance_port/

# Native probes: keep sources, never their executables or shader bytecode
/probes/*
!/probes/material-control/
!/probes/*.java
!/probes/*.mm
!/probes/*.cpp
!/probes/*.hpp
!/probes/*.h
!/probes/*.glsl
!/probes/*.comp
!/probes/*.rgen
!/probes/*.rchit
!/probes/*.rahit
!/probes/*.rmiss
!/probes/*.md

.DS_Store
._*
__pycache__/
*.pyc
*.spv
*.log
*.dylib
*.so
*.o
*.a
*.jar
*.zip
hs_err_pid*
.env
